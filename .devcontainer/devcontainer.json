{
	"name": "Avalanche Starter Kit",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"version": "latest",
			"moby": true,
			"dockerDashComposeVersion": "v2"
		}
	},
	"remoteEnv": {
		"PATH": "${containerEnv:HOME}/.foundry/bin:${containerEnv:PATH}",
		"FOUNDRY_DISABLE_NIGHTLY_WARNING": "1"
	},
	"postCreateCommand": {
		"init-git": "git config --global --add safe.directory ${containerWorkspaceFolder}",
		"init-submodules": "git submodule update --init --recursive",
		"verify-foundry": "forge --version && cast --version && anvil --version"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"juanblanco.solidity",
				"NomicFoundation.hardhat-solidity"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash"
			}
		}
	}
}
